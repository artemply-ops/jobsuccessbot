# Образ для общего сервера: фронтенд НЕ собирается здесь.
# web/dist собирается локально (npm run build) и кладётся на сервер через scripts/deploy.sh.
# Причина: npm ci на сервере съедал свободную память, ядро убивало процессы (OOM 16.10.2026).
# apt и pip живут в базовом образе (Dockerfile.base): здесь только код, сборка занимает секунды.
ARG BASE=jobsuccess-base:latest
FROM ${BASE}
WORKDIR /app
COPY backend/ backend/
COPY data/companies_seed.yaml data/
COPY web/dist web/dist
ENV PYTHONUTF8=1 PYTHONPATH=/app/backend
WORKDIR /app/backend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
