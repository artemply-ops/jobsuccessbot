# Скопируйте в .env и заполните. .env в git не попадает.
ENV=dev
# DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
PUBLIC_URL=http://localhost:8000
JWT_SECRET=сгенерируйте-длинную-случайную-строку

# Telegram: токен от @BotFather, username бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TG_IDS=[]

# LLM через OpenRouter. Во внешнюю модель уходит только обезличенный текст
LLM_API_KEY=
LLM_MODEL_MAIN=anthropic/claude-sonnet-5.5
LLM_MODEL_SCORING=anthropic/claude-haiku-5.5

# Yandex SpeechKit для голосовых (голос это ПДн, поэтому российский провайдер)
STT_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# SuperJob API (необязательно): без ключа источник выключен
SUPERJOB_APP_ID=

RUN_SCHEDULER=false

# ---- Сервер (docker-compose.server.yml) ----
# DOMAIN=201-24-55-219.sslip.io
# POSTGRES_PASSWORD=
# PROXY_URL=socks5://...          прокси для Telegram API
# LLM_PROXY_URL=socks5://...      прокси для OpenRouter (с российских IP отвечает 403)
