# Скопируйте в .env и заполните. .env в git не попадает.
ENV=dev
# DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
PUBLIC_URL=http://localhost:8000
JWT_SECRET=сгенерируйте-длинную-случайную-строку

# Telegram: токен от @BotFather, username бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TG_IDS=[]

# Claude API. Во внешнюю модель уходит только обезличенный текст
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-opus-5
ANTHROPIC_MODEL_SCORING=claude-sonnet-5

# Yandex SpeechKit для голосовых (голос это ПДн, поэтому российский провайдер)
STT_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# SuperJob API (необязательно): без ключа источник выключен
SUPERJOB_APP_ID=

RUN_SCHEDULER=false
